# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS (admin panel + expo web).
CLIENT_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# ---- Database ----
# Local MongoDB or a free MongoDB Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/besqaa

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Bootstrap admin (created on first run by `npm run seed`) ----
SEED_ADMIN_NAME=Besqaa Admin
SEED_ADMIN_EMAIL=admin@besqaa.in
SEED_ADMIN_PASSWORD=Admin@12345

# ---- AWS S3 (product images) ----
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=besqaa-product-images
# Optional public base URL (e.g. CloudFront). Leave empty to use the default S3 URL.
S3_PUBLIC_BASE_URL=

# ---- Email (order-confirmed notifications) ----
# Leave empty to log emails to the console instead (dev mode).
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<app password from Google Account > Security > App passwords>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Besqaa <no-reply@besqaa.in>
