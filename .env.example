# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS (admin panel + expo web).
CLIENT_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# ---- Database ----
# Local MongoDB or a free MongoDB Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/besqaa

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Bootstrap admin (created on first run by `npm run seed`) ----
SEED_ADMIN_NAME=Besqaa Admin
SEED_ADMIN_EMAIL=admin@besqaa.in
SEED_ADMIN_PASSWORD=Admin@12345

# ---- AWS S3 (product images) ----
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=besqaa-product-images
# Optional public base URL (e.g. CloudFront). Leave empty to use the default S3 URL.
S3_PUBLIC_BASE_URL=

# ---- Email (OTP + order-confirmed notifications) ----
# MAIL_PROVIDER picks the sender:
#   sendgrid → Twilio SendGrid HTTPS API (needs SENDGRID_API_KEY "SG..." + MAIL_FROM verified in SendGrid)
#   resend   → Resend HTTPS API (needs RESEND_API_KEY + a domain verified in Resend)
#   brevo    → Brevo HTTPS API  (needs BREVO_API_KEY + MAIL_FROM verified as a sender in Brevo)
#   ses      → Amazon SES using the AWS keys above
#   empty    → SMTP when filled in, otherwise log emails to the console (dev mode)
# NOTE: Render's free tier blocks outbound SMTP (ports 25/465/587) — use an
# HTTPS provider there.
MAIL_PROVIDER=
SENDGRID_API_KEY=
RESEND_API_KEY=
BREVO_API_KEY=
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<app password from Google Account > Security > App passwords>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Besqaa <no-reply@besqaa.in>

# ---- SMS OTP (phone verification) ----
# SMS_PROVIDER picks the sender:
#   twilio → Twilio Messages API (needs TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM)
#   sns    → AWS SNS using the AWS keys above (India: also set SMS_DLT_* for the local route)
#   empty  → log SMS to the console (dev mode)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio phone number (+1...) or a Messaging Service SID (MG...)
TWILIO_FROM=
